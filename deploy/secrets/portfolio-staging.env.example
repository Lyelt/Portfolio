# Copy to /srv/secrets/portfolio/staging.env inside the VM.
# Replace every replace-* value; this file is an example and contains no secret.
POSTGRES_DB=portfolio_staging
POSTGRES_USER=portfolio_staging
POSTGRES_PASSWORD=replace-with-unique-staging-database-password
CONNECTION_STRING=Host=db;Port=5432;Database=portfolio_staging;Username=portfolio_staging;Password=replace-with-the-same-staging-database-password
JWT_SECURITY_KEY=replace-with-unique-random-staging-jwt-key
JWT_ISSUER=https://staging.ghobrial.dev
JWT_AUDIENCE=https://staging.ghobrial.dev
GAME_NIGHT_FIRST_USER_NAME=
