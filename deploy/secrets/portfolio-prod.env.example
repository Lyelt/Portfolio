# Copy to /srv/secrets/portfolio/prod.env inside the VM.
# Replace every replace-* value; never reuse staging credentials in production.
POSTGRES_DB=portfolio_prod
POSTGRES_USER=portfolio_prod
POSTGRES_PASSWORD=replace-with-unique-production-database-password
CONNECTION_STRING=Host=db;Port=5432;Database=portfolio_prod;Username=portfolio_prod;Password=replace-with-the-same-production-database-password
JWT_SECURITY_KEY=replace-with-unique-random-production-jwt-key
JWT_ISSUER=https://ghobrial.dev
JWT_AUDIENCE=https://ghobrial.dev
GAME_NIGHT_FIRST_USER_NAME=
