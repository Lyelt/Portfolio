#!/usr/bin/env bash

set -Eeuo pipefail
set +x
umask 027

readonly PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

readonly REPOSITORY_URL='https://github.com/Lyelt/Portfolio.git'
readonly REPOSITORY_SLUG='Lyelt/Portfolio'
readonly BASE_DIR='/srv/apps/portfolio'
readonly REPOSITORY_DIR="${BASE_DIR}/repository.git"
readonly SECRETS_DIR='/srv/secrets/portfolio'
readonly BACKUPS_DIR='/srv/backups/portfolio'
readonly LOCK_FILE='/srv/apps/.deploy.lock'
readonly COMPOSE_RELATIVE_PATH='deploy/portfolio/compose.yml'
readonly INSTALLED_SCRIPT='/usr/local/sbin/deploy-portfolio'
readonly MANIFEST_VALIDATOR='/usr/local/sbin/validate-deployment-manifest'
readonly SCHEMA_CONTRACT='/usr/local/share/portfolio/schema-contract.sql'
readonly SCHEMA_CONTRACT_RELATIVE_PATH='deploy/portfolio/schema-contract.sql'
readonly PRODUCTION_SENTINEL="${SECRETS_DIR}/production-enabled"
readonly RECOVERY_APPROVAL="${SECRETS_DIR}/production-recovery.env"
readonly RECOVERY_SOURCE_LABEL='com.ghobrial.portfolio.recovery.source-sha'
readonly RECOVERY_IMAGE_LABEL='com.ghobrial.portfolio.recovery.image-ref'
readonly RECOVERY_BACKUP_LABEL='com.ghobrial.portfolio.recovery.backup-sha256'
readonly RECOVERY_APPROVAL_MAX_AGE_SECONDS=86400
readonly DEPLOY_HOME="${HOME:-/home/deploy}"
readonly MINIMUM_FREE_KIB=$((12 * 1024 * 1024))

temporary_release=''
temporary_backup=''
temporary_checksum=''
temporary_link=''
temporary_recovery_consumed=''
recovery_mode='false'
recovery_backup_sha=''
recovery_consumed_file=''

log() {
  printf '[portfolio-deploy] %s\n' "$*"
}

fail() {
  printf '[portfolio-deploy] ERROR: %s\n' "$*" >&2
  exit 1
}

cleanup() {
  if [[ -n "${temporary_release}" && -d "${temporary_release}" ]]; then
    rm -rf -- "${temporary_release}"
  fi
  if [[ -n "${temporary_backup}" && -f "${temporary_backup}" ]]; then
    rm -f -- "${temporary_backup}"
  fi
  if [[ -n "${temporary_checksum}" && -f "${temporary_checksum}" ]]; then
    rm -f -- "${temporary_checksum}"
  fi
  if [[ -n "${temporary_link}" && -L "${temporary_link}" ]]; then
    rm -f -- "${temporary_link}"
  fi
  if [[ -n "${temporary_recovery_consumed}" && -f "${temporary_recovery_consumed}" ]]; then
    rm -f -- "${temporary_recovery_consumed}"
  fi
}
trap cleanup EXIT

usage() {
  printf 'Usage: %s --preflight <staging|prod>\n' "$0" >&2
  printf '       %s <staging|prod> <40-character-commit-sha> <ghcr-image@sha256:digest>\n' "$0" >&2
  exit 64
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command is unavailable: $1"
}

assert_fixed_host_install() {
  local invoked_path owner group mode permissions

  invoked_path="$(readlink -f -- "$0")"
  [[ "${invoked_path}" == "${INSTALLED_SCRIPT}" ]] ||
    fail "Run the fixed host copy at ${INSTALLED_SCRIPT}; repository scripts are not executable deployment inputs."

  owner="$(stat -c '%U' -- "${INSTALLED_SCRIPT}")"
  group="$(stat -c '%G' -- "${INSTALLED_SCRIPT}")"
  mode="$(stat -c '%a' -- "${INSTALLED_SCRIPT}")"
  permissions=$((8#${mode}))

  [[ "${owner}:${group}" == 'root:root' ]] ||
    fail "${INSTALLED_SCRIPT} must be owned by root:root."
  (( (permissions & 0022) == 0 )) ||
    fail "${INSTALLED_SCRIPT} must not be writable by group or other users."

  [[ -f "${SCHEMA_CONTRACT}" && ! -L "${SCHEMA_CONTRACT}" ]] ||
    fail "Missing installed schema contract: ${SCHEMA_CONTRACT}"
  [[ "$(stat -c '%U:%G %a' -- "${SCHEMA_CONTRACT}")" == 'root:root 644' ]] ||
    fail "${SCHEMA_CONTRACT} must be owned by root:root with mode 0644."
  [[ -f "${MANIFEST_VALIDATOR}" && ! -L "${MANIFEST_VALIDATOR}" ]] ||
    fail "Missing shared manifest validator: ${MANIFEST_VALIDATOR}"
  [[ "$(stat -c '%U:%G %a' -- "${MANIFEST_VALIDATOR}")" == 'root:root 755' ]] ||
    fail "${MANIFEST_VALIDATOR} must be owned by root:root with mode 0755."
}

assert_secret_file() {
  local file="$1"
  local owner group mode

  [[ -f "${file}" && ! -L "${file}" ]] || fail "Missing environment file: ${file}"
  owner="$(stat -c '%U' -- "${file}")"
  group="$(stat -c '%G' -- "${file}")"
  mode="$(stat -c '%a' -- "${file}")"

  [[ "${owner}:${group}" == 'root:deploy' && "${mode}" == '640' ]] ||
    fail "${file} must be a regular root:deploy file with mode 0640."
}

assert_sentinel() {
  local owner group mode permissions

  [[ -f "${PRODUCTION_SENTINEL}" && ! -L "${PRODUCTION_SENTINEL}" ]] ||
    fail "Production is disabled on this host; ${PRODUCTION_SENTINEL} does not exist."
  owner="$(stat -c '%U' -- "${PRODUCTION_SENTINEL}")"
  group="$(stat -c '%G' -- "${PRODUCTION_SENTINEL}")"
  mode="$(stat -c '%a' -- "${PRODUCTION_SENTINEL}")"
  permissions=$((8#${mode}))

  [[ "${owner}:${group}" == 'root:deploy' ]] ||
    fail "The production sentinel must be owned by root:deploy."
  (( (permissions & 0022) == 0 )) ||
    fail "The production sentinel must not be writable by group or other users."
}

require_nonempty_env_key() {
  local file="$1"
  local required_key="$2"
  local line key_value=''
  local assignments=0

  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%$'\r'}"
    if [[ "${line}" =~ ^[[:space:]]*${required_key}[[:space:]]*= ]]; then
      assignments=$((assignments + 1))
      key_value="${line#*=}"
    fi
  done < "${file}"

  [[ ${assignments} -eq 1 ]] ||
    fail "${file} must define ${required_key} exactly once."

  key_value="${key_value#"${key_value%%[![:space:]]*}"}"
  key_value="${key_value%"${key_value##*[![:space:]]}"}"
  [[ -n "${key_value}" && "${key_value}" != "''" && "${key_value}" != '""' ]] ||
    fail "${required_key} must not be empty in ${file}."
  [[ "${key_value}" != *'replace-'* ]] ||
    fail "${required_key} still contains an example placeholder in ${file}."

  key_value=''
}

read_exact_assignment() {
  local file="$1"
  local key="$2"
  local value

  [[ "$(grep -Ec "^${key}=" "${file}")" == '1' ]] ||
    fail "${file} must define ${key} exactly once."
  value="$(grep -E "^${key}=" "${file}" | cut -d= -f2-)"
  [[ -n "${value}" ]] || fail "${key} must not be empty in ${file}."
  printf '%s\n' "${value}"
}

assert_recovered_production_volume() {
  local requested_source="$1"
  local requested_image="$2"
  local approved_source approved_image approved_volume approved_epoch now_epoch approval_age
  local volume_source volume_image volume_backup
  local -a attached_containers

  assert_secret_file "${RECOVERY_APPROVAL}"
  [[ "$(grep -Ec '^(SOURCE_SHA|IMAGE_REF|DATABASE_VOLUME|BACKUP_SHA256|APPROVED_AT_EPOCH)=' "${RECOVERY_APPROVAL}")" == '5' ]] ||
    fail 'The production recovery approval must contain exactly five canonical assignments.'
  [[ "$(grep -Evc '^(SOURCE_SHA|IMAGE_REF|DATABASE_VOLUME|BACKUP_SHA256|APPROVED_AT_EPOCH)=' "${RECOVERY_APPROVAL}")" == '0' ]] ||
    fail 'The production recovery approval contains an unexpected assignment.'

  approved_source="$(read_exact_assignment "${RECOVERY_APPROVAL}" SOURCE_SHA)"
  approved_image="$(read_exact_assignment "${RECOVERY_APPROVAL}" IMAGE_REF)"
  approved_volume="$(read_exact_assignment "${RECOVERY_APPROVAL}" DATABASE_VOLUME)"
  recovery_backup_sha="$(read_exact_assignment "${RECOVERY_APPROVAL}" BACKUP_SHA256)"
  approved_epoch="$(read_exact_assignment "${RECOVERY_APPROVAL}" APPROVED_AT_EPOCH)"

  [[ "${approved_source}" == "${requested_source}" ]] ||
    fail 'The recovered backup source marker does not match the requested release.'
  [[ "${approved_image}" == "${requested_image}" ]] ||
    fail 'The recovered backup image marker does not match the requested immutable image.'
  [[ "${approved_volume}" == "${database_volume}" ]] ||
    fail 'The recovered backup approval names an unexpected database volume.'
  [[ "${recovery_backup_sha}" =~ ^[0-9a-f]{64}$ ]] ||
    fail 'The recovered backup approval has an invalid backup digest.'
  recovery_consumed_file="${recovery_consumed_dir}/${recovery_backup_sha}"
  [[ ! -e "${recovery_consumed_file}" && ! -L "${recovery_consumed_file}" ]] ||
    fail 'This production backup has already been used for recovery.'
  [[ "${approved_epoch}" =~ ^[0-9]+$ ]] ||
    fail 'The recovered backup approval has an invalid timestamp.'
  now_epoch="$(date -u +%s)"
  approval_age=$((now_epoch - approved_epoch))
  (( approval_age >= 0 && approval_age <= RECOVERY_APPROVAL_MAX_AGE_SECONDS )) ||
    fail 'The recovered backup approval is expired or dated in the future; rerun the root-owned restore helper.'

  docker volume inspect "${database_volume}" >/dev/null 2>&1 ||
    fail "The approved recovered database volume is missing: ${database_volume}"
  mapfile -t attached_containers < <(docker ps --all --quiet --filter "volume=${database_volume}")
  [[ "${#attached_containers[@]}" == '0' ]] ||
    fail 'The recovered database volume is still attached to a container.'
  volume_source="$(docker volume inspect --format "{{index .Labels \"${RECOVERY_SOURCE_LABEL}\"}}" "${database_volume}")"
  volume_image="$(docker volume inspect --format "{{index .Labels \"${RECOVERY_IMAGE_LABEL}\"}}" "${database_volume}")"
  volume_backup="$(docker volume inspect --format "{{index .Labels \"${RECOVERY_BACKUP_LABEL}\"}}" "${database_volume}")"
  [[ "${volume_source}" == "${approved_source}" &&
      "${volume_image}" == "${approved_image}" &&
      "${volume_backup}" == "${recovery_backup_sha}" ]] ||
    fail 'The recovered database volume labels do not match the root-owned recovery approval.'
}

compose_for() {
  local release="$1"
  local image_ref="$2"
  local source_sha="$3"
  shift 3

  (
    cd "${BASE_DIR}"
    env -i \
      HOME="${DEPLOY_HOME}" \
      PATH="${PATH}" \
      DEPLOY_ENV="${deployment_environment}" \
      APP_ENVIRONMENT="${app_environment}" \
      DB_VOLUME_NAME="${database_volume}" \
      IMAGE_REF="${image_ref}" \
      IMAGE_TAG="${source_sha}" \
      WEB_ALIAS="${web_alias}" \
      docker compose \
        --env-file "${secrets_file}" \
        --project-name "${compose_project}" \
        --file "${release}/${COMPOSE_RELATIVE_PATH}" \
        "$@"
  )
}

database_container_id() {
  local release="$1"
  local image_ref="$2"
  local source_sha="$3"

  compose_for "${release}" "${image_ref}" "${source_sha}" ps --quiet db 2>/dev/null
}

assert_database_volume_mount() {
  local release="$1"
  local image_ref="$2"
  local source_sha="$3"
  local expected_volume="$4"
  local container_id mounted_volume

  container_id="$(database_container_id "${release}" "${image_ref}" "${source_sha}")"
  [[ -n "${container_id}" ]] || fail 'Current database container is missing.'
  mounted_volume="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/var/lib/postgresql/data"}}{{.Name}}{{end}}{{end}}' "${container_id}")"
  [[ "${mounted_volume}" == "${expected_volume}" ]] ||
    fail "Current database mount does not match protected selector ${expected_volume}."
}

database_is_healthy() {
  local release="$1"
  local image_ref="$2"
  local source_sha="$3"
  local container_id health_status running

  container_id="$(database_container_id "${release}" "${image_ref}" "${source_sha}")"
  [[ -n "${container_id}" ]] || return 1

  running="$(docker inspect --format '{{.State.Running}}' "${container_id}" 2>/dev/null || true)"
  health_status="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "${container_id}" 2>/dev/null || true)"
  [[ "${running}" == 'true' && "${health_status}" == 'healthy' ]]
}

wait_for_database() {
  local release="$1"
  local image_ref="$2"
  local source_sha="$3"
  local attempt

  for attempt in $(seq 1 60); do
    if database_is_healthy "${release}" "${image_ref}" "${source_sha}"; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_for_application() {
  local release="$1"
  local image_ref="$2"
  local source_sha="$3"
  local attempt container_id health_status running

  for attempt in $(seq 1 75); do
    container_id="$(compose_for "${release}" "${image_ref}" "${source_sha}" ps --quiet app 2>/dev/null || true)"
    if [[ -n "${container_id}" ]]; then
      running="$(docker inspect --format '{{.State.Running}}' "${container_id}" 2>/dev/null || true)"
      health_status="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "${container_id}" 2>/dev/null || true)"
    else
      running='false'
      health_status=''
    fi

    if [[ "${running}" == 'true' && "${health_status}" == 'healthy' ]]; then
      return 0
    fi
    sleep 2
  done
  return 1
}

read_current_release() {
  local link_path="$1"
  local release_root="$2"
  local resolved

  [[ -L "${link_path}" ]] || return 1
  resolved="$(readlink -f -- "${link_path}")"
  [[ -n "${resolved}" && "${resolved}" == "${release_root}/"* ]] ||
    fail "Current release link points outside ${release_root}."
  [[ -f "${resolved}/.source-sha" && ! -L "${resolved}/.source-sha" ]] ||
    fail "Current release is missing its source marker."
  printf '%s\n' "${resolved}"
}

create_database_backup() {
  local release="$1"
  local image_ref="$2"
  local source_sha="$3"
  local backup_dir timestamp final_backup final_checksum backup_hash safe_label

  safe_label="${image_ref//\//-}"
  safe_label="${safe_label//@/-}"
  safe_label="${safe_label//:/-}"

  backup_dir="${BACKUPS_DIR}/${deployment_environment}"
  [[ -d "${backup_dir}" && -w "${backup_dir}" ]] ||
    fail "Database backup directory is unavailable: ${backup_dir}"

  timestamp="$(date -u '+%Y%m%dT%H%M%S%NZ')"
  final_backup="${backup_dir}/${timestamp}-${safe_label}.dump"
  temporary_backup="$(mktemp "${backup_dir}/.${timestamp}-${safe_label}.XXXXXX.dump")"
  chmod 0600 "${temporary_backup}"

  log "Creating ${deployment_environment} PostgreSQL backup before image replacement or service restart."
  if ! compose_for "${release}" "${image_ref}" "${source_sha}" exec -T db \
    sh -ceu 'exec pg_dump --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --format=custom --no-owner --no-acl' \
    > "${temporary_backup}"; then
    fail 'Database backup failed; deployment was not started.'
  fi
  [[ -s "${temporary_backup}" ]] || fail 'Database backup is empty.'

  if ! compose_for "${release}" "${image_ref}" "${source_sha}" exec -T db \
    pg_restore --list < "${temporary_backup}" >/dev/null; then
    fail 'Database backup validation failed; deployment was not started.'
  fi

  [[ ! -e "${final_backup}" ]] || fail "Backup destination already exists: ${final_backup}"
  final_checksum="${final_backup}.sha256"
  [[ ! -e "${final_checksum}" ]] || fail "Backup checksum destination already exists: ${final_checksum}"
  mv -- "${temporary_backup}" "${final_backup}"
  temporary_backup=''
  backup_hash="$(sha256sum "${final_backup}" | awk '{ print $1 }')"
  temporary_checksum="$(mktemp "${backup_dir}/.${timestamp}-${safe_label}.XXXXXX.sha256")"
  chmod 0600 "${temporary_checksum}"
  printf '%s  %s\n' "${backup_hash}" "$(basename "${final_backup}")" > "${temporary_checksum}"
  mv -- "${temporary_checksum}" "${final_checksum}"
  temporary_checksum=''
  log "Validated database backup and checksum: ${final_backup}"
}

assert_canonical_database_schema() {
  local release="$1"
  local image_ref="$2"
  local source_sha="$3"
  local contract="${4:-${SCHEMA_CONTRACT}}"

  [[ -f "${contract}" && ! -L "${contract}" ]] ||
    fail "Missing canonical schema contract: ${contract}"
  compose_for "${release}" "${image_ref}" "${source_sha}" exec -T db \
    sh -ceu 'exec psql --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --set=ON_ERROR_STOP=1' \
    < "${contract}" ||
    fail 'The database does not match the canonical Portfolio schema contract.'
}

stop_failed_application() {
  local new_release="$1"
  local new_image_ref="$2"
  local new_sha="$3"

  log 'Application failed health checks; stopping the failed container.'
  compose_for "${new_release}" "${new_image_ref}" "${new_sha}" stop --timeout 30 app >/dev/null 2>&1 || true
  fail 'Deployment failed health checks. The database volume and pre-deployment backup were retained; recover the paired database and approved image through the documented procedure.'
}

preflight_only='false'
if [[ $# -eq 2 && "$1" == '--preflight' ]]; then
  readonly requested_environment="$2"
  readonly requested_sha=''
  readonly requested_image_ref=''
  preflight_only='true'
elif [[ $# -eq 3 ]]; then
  readonly requested_environment="$1"
  readonly requested_sha="$2"
  readonly requested_image_ref="$3"
else
  usage
fi
readonly preflight_only

if [[ "${preflight_only}" != 'true' ]]; then
  [[ "${requested_sha}" =~ ^[0-9a-f]{40}$ ]] ||
    fail 'Commit SHA must be exactly 40 lowercase hexadecimal characters.'
  [[ "${requested_image_ref}" =~ ^ghcr\.io/lyelt/portfolio@sha256:[0-9a-f]{64}$ ]] ||
    fail 'Image must be the Portfolio GHCR image with a full SHA-256 digest.'
fi

case "${requested_environment}" in
  staging)
    readonly deployment_environment='staging'
    readonly manifest_environment='staging'
    readonly expected_branch='staging'
    readonly compose_project='portfolio-staging'
    readonly web_alias='portfolio-staging-web'
    readonly app_environment='Staging'
    readonly database_volume='portfolio-staging-postgres-data'
    ;;
  prod)
    readonly deployment_environment='prod'
    readonly manifest_environment='production'
    readonly expected_branch='master'
    readonly compose_project='portfolio-prod'
    readonly web_alias='portfolio-prod-web'
    readonly app_environment='Production'
    readonly database_volume='portfolio-prod-postgres-data'
    ;;
  *)
    usage
    ;;
esac

readonly environment_dir="${BASE_DIR}/${deployment_environment}"
readonly releases_dir="${environment_dir}/releases"
readonly current_link="${environment_dir}/current"
readonly secrets_file="${SECRETS_DIR}/${deployment_environment}.env"
readonly recovery_consumed_dir="${environment_dir}/recovery-consumed"

for required_command in awk cut date df docker flock git grep mktemp readlink seq sha256sum stat tar; do
  require_command "${required_command}"
done

[[ "$(id -un)" == 'deploy' ]] || fail 'Deployments must run as the deploy user.'
assert_fixed_host_install

[[ -d "${BASE_DIR}" && ! -L "${BASE_DIR}" ]] || fail "Missing host directory: ${BASE_DIR}"
[[ -d "${environment_dir}" && ! -L "${environment_dir}" ]] || fail "Missing host directory: ${environment_dir}"
[[ -d "${releases_dir}" && -w "${releases_dir}" && ! -L "${releases_dir}" ]] ||
  fail "Release directory is unavailable: ${releases_dir}"
if [[ "${deployment_environment}" == 'prod' ]]; then
  [[ -d "${recovery_consumed_dir}" && ! -L "${recovery_consumed_dir}" ]] ||
    fail "Missing guarded recovery-consumption directory: ${recovery_consumed_dir}"
  [[ "$(stat -c '%U:%G %a' -- "${recovery_consumed_dir}")" == 'deploy:deploy 750' ]] ||
    fail "${recovery_consumed_dir} must be deploy:deploy with mode 0750."
fi
[[ -S '/var/run/docker.sock' ]] || fail 'Docker socket is unavailable.'
docker network inspect web >/dev/null 2>&1 || fail 'Required external Docker network does not exist: web'

assert_secret_file "${secrets_file}"
for required_key in \
  POSTGRES_DB \
  POSTGRES_PASSWORD \
  POSTGRES_USER \
  CONNECTION_STRING \
  JWT_AUDIENCE \
  JWT_ISSUER \
  JWT_SECURITY_KEY; do
  require_nonempty_env_key "${secrets_file}" "${required_key}"
done

if [[ "${deployment_environment}" == 'prod' ]]; then
  assert_sentinel
fi

if [[ "${preflight_only}" == 'true' ]]; then
  log "Host preflight passed for ${deployment_environment}."
  exit 0
fi

exec 9>"${LOCK_FILE}"
flock --timeout 1800 9 || fail 'Another portfolio deployment held the global lock for more than 30 minutes.'

available_kib="$(df --output=avail "${BASE_DIR}" | awk 'NR == 2 { print $1 }')"
[[ "${available_kib}" =~ ^[0-9]+$ ]] || fail 'Could not determine free space for the deployment filesystem.'
(( available_kib >= MINIMUM_FREE_KIB )) ||
  fail 'Less than 12 GiB is free in the VM; deployment stopped before backup, build, or restart. Review retention and backup policy manually.'

if [[ -e "${current_link}" && ! -L "${current_link}" ]]; then
  fail "Current release path exists but is not a symbolic link: ${current_link}"
fi

current_release=''
current_sha=''
current_image_ref=''
if current_release="$(read_current_release "${current_link}" "${releases_dir}")"; then
  IFS= read -r current_sha < "${current_release}/.source-sha"
  [[ "${current_sha}" =~ ^[0-9a-f]{40}$ ]] || fail 'Current release has an invalid source marker.'
  [[ -f "${current_release}/.image-ref" && ! -L "${current_release}/.image-ref" ]] ||
    fail 'Current release is missing its immutable image marker.'
  IFS= read -r current_image_ref < "${current_release}/.image-ref"
  [[ "${current_image_ref}" =~ ^ghcr\.io/lyelt/portfolio@sha256:[0-9a-f]{64}$ ]] ||
    fail 'Current release has an invalid image marker.'
  assert_database_volume_mount "${current_release}" "${current_image_ref}" "${current_sha}" "${database_volume}"
elif [[ "${deployment_environment}" == 'prod' ]]; then
  assert_recovered_production_volume "${requested_sha}" "${requested_image_ref}"
  recovery_mode='true'
fi

if [[ "${recovery_mode}" != 'true' ]]; then
  [[ "${GITHUB_ACTIONS:-}" == 'true' ]] ||
    fail 'Normal deployments may run only from GitHub Actions.'
  [[ "${GITHUB_SERVER_URL:-}" == 'https://github.com' ]] ||
    fail 'GITHUB_SERVER_URL is not the approved GitHub origin.'
  [[ "${GITHUB_REPOSITORY:-}" == "${REPOSITORY_SLUG}" ]] ||
    fail 'GITHUB_REPOSITORY does not match the Portfolio repository.'
  [[ "${GITHUB_SHA:-}" == "${requested_sha}" ]] ||
    fail 'GITHUB_SHA does not match the requested commit.'
  [[ "${GITHUB_REF:-}" == "refs/heads/${expected_branch}" ]] ||
    fail 'GITHUB_REF does not match the deployment branch.'
  [[ "${GITHUB_RUN_ID:-}" =~ ^[1-9][0-9]*$ ]] ||
    fail 'GITHUB_RUN_ID is invalid.'
  [[ "${GITHUB_RUN_ATTEMPT:-}" =~ ^[1-9][0-9]*$ ]] ||
    fail 'GITHUB_RUN_ATTEMPT is invalid.'
  "${MANIFEST_VALIDATOR}" \
    portfolio \
    "${manifest_environment}" \
    "${REPOSITORY_SLUG}" \
    "${expected_branch}" \
    "${requested_sha}" \
    "${requested_image_ref}" \
    "${GITHUB_RUN_ID}" \
    "${GITHUB_RUN_ATTEMPT}" \
    "${COMPOSE_RELATIVE_PATH}"
fi

if [[ -e "${REPOSITORY_DIR}" && ( ! -d "${REPOSITORY_DIR}" || -L "${REPOSITORY_DIR}" ) ]]; then
  fail "Repository cache is not a safe directory: ${REPOSITORY_DIR}"
fi
if [[ ! -d "${REPOSITORY_DIR}" ]]; then
  git init --bare --quiet "${REPOSITORY_DIR}"
fi
git --git-dir="${REPOSITORY_DIR}" remote remove origin >/dev/null 2>&1 || true
git --git-dir="${REPOSITORY_DIR}" remote add origin "${REPOSITORY_URL}"

log "Fetching ${expected_branch} from the fixed GitHub repository."
git --git-dir="${REPOSITORY_DIR}" \
  -c protocol.file.allow=never \
  -c protocol.ext.allow=never \
  fetch --force --no-tags origin \
  "refs/heads/${expected_branch}:refs/remotes/origin/${expected_branch}"

remote_sha="$(git --git-dir="${REPOSITORY_DIR}" rev-parse --verify "refs/remotes/origin/${expected_branch}^{commit}")"
resolved_sha="$(git --git-dir="${REPOSITORY_DIR}" rev-parse --verify "${requested_sha}^{commit}")"
[[ "${resolved_sha}" == "${requested_sha}" ]] ||
  fail 'Requested SHA did not resolve to the exact requested commit.'
if [[ "${recovery_mode}" == 'true' ]]; then
  git --git-dir="${REPOSITORY_DIR}" merge-base --is-ancestor "${requested_sha}" "${remote_sha}" ||
    fail "The recovered source is not part of the protected ${expected_branch} history."
else
  [[ "${remote_sha}" == "${requested_sha}" ]] ||
    fail "Requested SHA is not the exact current head of ${expected_branch}; a newer workflow should deploy the newer head."
fi

if [[ "${current_sha}" == "${requested_sha}" ]]; then
  [[ "${current_image_ref}" == "${requested_image_ref}" ]] ||
    fail 'Current source marker matches, but its immutable image digest differs from the accepted request.'
  database_is_healthy "${current_release}" "${current_image_ref}" "${current_sha}" ||
    fail 'Current release marker matches, but the selected database is not healthy.'
  compose_for "${current_release}" "${current_image_ref}" "${current_sha}" config --quiet
  create_database_backup "${current_release}" "${current_image_ref}" "${current_sha}"
  log "Commit ${requested_sha} is already current; recreating the application so reviewed protected configuration is reloaded."
  compose_for "${current_release}" "${current_image_ref}" "${current_sha}" \
    up --detach --force-recreate --no-deps --no-build app
  wait_for_application "${current_release}" "${current_image_ref}" "${current_sha}" ||
    fail 'Same-SHA configuration reload did not return the application to a healthy state; restore the staged environment backup and rerun the workflow.'
  log "Configuration reload is healthy for ${deployment_environment} at ${requested_sha}."
  exit 0
fi

temporary_release="$(mktemp --directory "${releases_dir}/.incoming-${requested_sha}.XXXXXX")"
git --git-dir="${REPOSITORY_DIR}" archive --format=tar "${requested_sha}" |
  (
    umask 022
    tar --extract --directory "${temporary_release}"
  )

[[ -f "${temporary_release}/${COMPOSE_RELATIVE_PATH}" && ! -L "${temporary_release}/${COMPOSE_RELATIVE_PATH}" ]] ||
  fail "Commit is missing a regular ${COMPOSE_RELATIVE_PATH}."
[[ -f "${temporary_release}/${SCHEMA_CONTRACT_RELATIVE_PATH}" &&
    ! -L "${temporary_release}/${SCHEMA_CONTRACT_RELATIVE_PATH}" ]] ||
  fail "Commit is missing a regular ${SCHEMA_CONTRACT_RELATIVE_PATH}."
printf '%s\n' "${requested_sha}" > "${temporary_release}/.source-sha"
printf '%s\n' "${requested_image_ref}" > "${temporary_release}/.image-ref"
chmod -R go-w "${temporary_release}"
release_suffix="${temporary_release##*.}"
release_dir="${releases_dir}/${requested_sha}-${release_suffix}"
[[ ! -e "${release_dir}" ]] || fail "Generated release path already exists: ${release_dir}"
mv -- "${temporary_release}" "${release_dir}"
temporary_release=''

docker pull "${requested_image_ref}"
compose_for "${release_dir}" "${requested_image_ref}" "${requested_sha}" config --quiet

if [[ -n "${current_release}" ]]; then
  database_is_healthy "${current_release}" "${current_image_ref}" "${current_sha}" ||
    fail "The current ${deployment_environment} database is not healthy; refusing to restart it before a backup."
  create_database_backup "${current_release}" "${current_image_ref}" "${current_sha}"
elif [[ "${deployment_environment}" == 'prod' && "${recovery_mode}" != 'true' ]]; then
  fail 'Production has no current immutable release or exact approved recovered database.'
fi

log 'Validating non-root runtime access to required application files.'
if ! docker run --rm \
  --network none \
  --read-only \
  --cap-drop ALL \
  --security-opt no-new-privileges:true \
  --entrypoint /bin/sh \
  "${requested_image_ref}" \
  -ceu 'test "$(id -u)" -ne 0; test -r /app/appsettings.json; test -r /app/Portfolio.dll'; then
  fail 'Published image failed the non-root runtime file-access validation.'
fi

log 'Starting the environment-specific PostgreSQL service.'
compose_for "${release_dir}" "${requested_image_ref}" "${requested_sha}" up --detach --no-build db
wait_for_database "${release_dir}" "${requested_image_ref}" "${requested_sha}" || fail 'Database did not become healthy.'

if [[ "${recovery_mode}" == 'true' ]]; then
  log 'Snapshotting the authenticated historical database before its source image runs migrations.'
  create_database_backup "${release_dir}" "${requested_image_ref}" "${requested_sha}"
fi

log 'Applying database migrations with the published immutable image.'
if ! compose_for "${release_dir}" "${requested_image_ref}" "${requested_sha}" run --rm --no-deps migrate; then
  fail 'Database migration failed; the application was not replaced. The database may contain partial migration changes.'
fi
if [[ "${recovery_mode}" == 'true' ]]; then
  assert_canonical_database_schema \
    "${release_dir}" \
    "${requested_image_ref}" \
    "${requested_sha}" \
    "${release_dir}/${SCHEMA_CONTRACT_RELATIVE_PATH}"
else
  assert_canonical_database_schema "${release_dir}" "${requested_image_ref}" "${requested_sha}"
fi

log 'Replacing the application container.'
compose_for "${release_dir}" "${requested_image_ref}" "${requested_sha}" up --detach --no-deps --no-build app

if ! wait_for_application "${release_dir}" "${requested_image_ref}" "${requested_sha}"; then
  stop_failed_application "${release_dir}" "${requested_image_ref}" "${requested_sha}"
fi

temporary_link="${environment_dir}/.current-${requested_sha}-$$"
ln --symbolic "${release_dir}" "${temporary_link}"
mv --no-target-directory --force "${temporary_link}" "${current_link}"
temporary_link=''

log "Successfully deployed ${deployment_environment} at ${requested_sha}."
if [[ "${recovery_mode}" == 'true' ]]; then
  temporary_recovery_consumed="$(mktemp "${recovery_consumed_dir}/.${recovery_backup_sha}.XXXXXX")"
  printf 'SOURCE_SHA=%s\nIMAGE_REF=%s\nBACKUP_SHA256=%s\n' \
    "${requested_sha}" "${requested_image_ref}" "${recovery_backup_sha}" \
    > "${temporary_recovery_consumed}"
  chmod 0640 "${temporary_recovery_consumed}"
  mv -- "${temporary_recovery_consumed}" "${recovery_consumed_file}"
  temporary_recovery_consumed=''
  log "Recovery approval was consumed; remove the root-owned approval file: ${RECOVERY_APPROVAL}"
fi
log "VM free space after deployment: $(df --output=avail -h "${BASE_DIR}" | awk 'NR == 2 { print $1 }'). No releases, images, caches, or backups were deleted automatically."
