#!/usr/bin/env bash

set -Eeuo pipefail
set +x
umask 027

readonly PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

readonly REPOSITORY_URL='https://github.com/Lyelt/Portfolio'
readonly RUNNER_HOME='/srv/actions-runner/portfolio'
readonly DEPLOY_USER='deploy'
readonly INSTALLED_DEPLOY_SCRIPT='/usr/local/sbin/deploy-portfolio'
readonly RUNNER_ENV_FILE='/srv/secrets/github-runner.env'

fail() {
  printf '[register-runner] ERROR: %s\n' "$*" >&2
  exit 1
}

[[ ${EUID} -eq 0 ]] || fail 'Run this registration helper as root.'
[[ $# -eq 0 ]] || fail 'This helper takes no arguments; use the root-only runner environment file.'

[[ "$(uname -s)" == 'Linux' ]] || fail 'The runner must be registered inside the Ubuntu VM.'
case "$(uname -m)" in
  aarch64|arm64) ;;
  *) fail 'This runner template expects the Ubuntu ARM64 VM.' ;;
esac

id "${DEPLOY_USER}" >/dev/null 2>&1 || fail "Missing host user: ${DEPLOY_USER}"
id -nG "${DEPLOY_USER}" | tr ' ' '\n' | grep -Fxq docker ||
  fail "${DEPLOY_USER} must belong to the docker group."

[[ -f "${RUNNER_ENV_FILE}" && ! -L "${RUNNER_ENV_FILE}" ]] ||
  fail "Create ${RUNNER_ENV_FILE} as a regular root-owned file containing exactly RUNNER_REGISTRATION_TOKEN=<token>."
token_owner="$(stat -c '%U:%G' -- "${RUNNER_ENV_FILE}")"
token_mode="$(stat -c '%a' -- "${RUNNER_ENV_FILE}")"
[[ "${token_owner}" == 'root:root' && "${token_mode}" == '600' ]] ||
  fail "${RUNNER_ENV_FILE} must be owned by root:root with mode 0600."

[[ -x "${RUNNER_HOME}/config.sh" ]] ||
  fail "Extract the official Linux ARM64 GitHub Actions runner into ${RUNNER_HOME}, verify its published SHA-256 checksum, and run this helper again."
[[ ! -e "${RUNNER_HOME}/.runner" ]] ||
  fail 'This runner directory is already configured; no existing runner was changed.'

[[ -f "${INSTALLED_DEPLOY_SCRIPT}" && ! -L "${INSTALLED_DEPLOY_SCRIPT}" && -x "${INSTALLED_DEPLOY_SCRIPT}" ]] ||
  fail "Install the fixed deployment entrypoint at ${INSTALLED_DEPLOY_SCRIPT} before registering the runner."
deploy_script_owner="$(stat -c '%U:%G' -- "${INSTALLED_DEPLOY_SCRIPT}")"
deploy_script_mode="$(stat -c '%a' -- "${INSTALLED_DEPLOY_SCRIPT}")"
[[ "${deploy_script_owner}" == 'root:root' && "${deploy_script_mode}" == '755' ]] ||
  fail "${INSTALLED_DEPLOY_SCRIPT} must be owned by root:root with mode 0755."

install -d -o "${DEPLOY_USER}" -g "${DEPLOY_USER}" -m 0750 \
  /srv/apps/portfolio \
  /srv/apps/portfolio/staging \
  /srv/apps/portfolio/staging/releases \
  /srv/apps/portfolio/prod \
  /srv/apps/portfolio/prod/releases \
  /srv/backups/portfolio \
  /srv/backups/portfolio/staging \
  /srv/backups/portfolio/prod
install -d -o root -g "${DEPLOY_USER}" -m 0750 /srv/secrets/portfolio

chown -R "${DEPLOY_USER}:${DEPLOY_USER}" "${RUNNER_HOME}"
runner_name="$(hostname -s)-portfolio"
mapfile -t runner_environment < "${RUNNER_ENV_FILE}"
[[ ${#runner_environment[@]} -eq 1 && "${runner_environment[0]}" == RUNNER_REGISTRATION_TOKEN=* ]] ||
  fail "${RUNNER_ENV_FILE} must contain exactly one RUNNER_REGISTRATION_TOKEN=<token> assignment."
registration_token="${runner_environment[0]#RUNNER_REGISTRATION_TOKEN=}"
[[ -n "${registration_token}" && "${registration_token}" != *[[:space:]]* ]] ||
  fail 'RUNNER_REGISTRATION_TOKEN must be nonempty and contain no whitespace.'
runner_environment=()
export ACTIONS_RUNNER_INPUT_TOKEN="${registration_token}"

(
  cd "${RUNNER_HOME}"
  runuser -u "${DEPLOY_USER}" --preserve-environment -- \
    ./config.sh \
      --unattended \
      --url "${REPOSITORY_URL}" \
      --name "${runner_name}" \
      --labels 'linux,ARM64,portfolio-deploy' \
      --work '_work'
)
unset ACTIONS_RUNNER_INPUT_TOKEN
registration_token=''
rm -f -- "${RUNNER_ENV_FILE}"

[[ -x "${RUNNER_HOME}/svc.sh" ]] ||
  fail "Runner configuration completed, but ${RUNNER_HOME}/svc.sh was not generated."

(
  cd "${RUNNER_HOME}"
  ./svc.sh install "${DEPLOY_USER}"
  ./svc.sh start
  ./svc.sh status
)

printf '%s\n' \
  'Runner registered as a system service.' \
  "The short-lived registration credential was removed from ${RUNNER_ENV_FILE}." \
  "Fixed deployment entrypoint is installed at ${INSTALLED_DEPLOY_SCRIPT}." \
  'Production remains disabled until both the root-owned host sentinel and GitHub repository variable are enabled.'
