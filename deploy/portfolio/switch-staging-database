#!/usr/bin/env bash

set -Eeuo pipefail
set +x
umask 027

readonly PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

readonly BASE_DIR='/srv/apps/portfolio'
readonly ENVIRONMENT_DIR="${BASE_DIR}/staging"
readonly RELEASES_DIR="${ENVIRONMENT_DIR}/releases"
readonly CURRENT_LINK="${ENVIRONMENT_DIR}/current"
readonly LOCK_FILE="${BASE_DIR}/.deploy.lock"
readonly SECRETS_FILE='/srv/secrets/portfolio/staging.env'
readonly SELECTOR_FILE='/srv/secrets/portfolio/staging-database-volume'
readonly BACKUP_DIR='/srv/backups/portfolio/staging'
readonly COMPOSE_RELATIVE_PATH='deploy/portfolio/compose.yml'
readonly INSTALLED_SCRIPT='/usr/local/sbin/switch-portfolio-staging-database'
readonly COMPOSE_PROJECT='portfolio-staging'
readonly WEB_ALIAS='portfolio-staging-web'
readonly DEPLOY_HOME='/home/deploy'

temporary_backup=''
temporary_checksum=''
cutover_started=0
selector_switched=0
cutover_complete=0
old_volume=''
current_release=''
current_sha=''

log() {
  printf '[portfolio-db-switch] %s\n' "$*"
}

fail() {
  printf '[portfolio-db-switch] ERROR: %s\n' "$*" >&2
  exit 1
}

assert_protected_file() {
  local file="$1"
  local owner group mode

  [[ -f "${file}" && ! -L "${file}" ]] || fail "Missing protected file: ${file}"
  owner="$(stat -c '%U' -- "${file}")"
  group="$(stat -c '%G' -- "${file}")"
  mode="$(stat -c '%a' -- "${file}")"
  [[ "${owner}:${group}:${mode}" == 'root:deploy:640' ]] ||
    fail "${file} must be root:deploy mode 0640."
}

read_selector() {
  local lines=()
  local value

  assert_protected_file "${SELECTOR_FILE}"
  mapfile -t lines < "${SELECTOR_FILE}"
  [[ ${#lines[@]} -eq 1 ]] || fail "${SELECTOR_FILE} must contain exactly one line."
  value="${lines[0]%$'\r'}"
  [[ "${value}" =~ ^portfolio-staging-postgres-(data|restored-[a-z0-9]+)$ ]] ||
    fail 'The staging database selector contains an invalid volume name.'
  printf '%s\n' "${value}"
}

write_selector() {
  local value="$1"
  local temporary_selector

  temporary_selector="$(mktemp /srv/secrets/portfolio/.staging-database-volume.XXXXXX)"
  printf '%s\n' "${value}" > "${temporary_selector}"
  chown root:deploy "${temporary_selector}"
  chmod 0640 "${temporary_selector}"
  mv -- "${temporary_selector}" "${SELECTOR_FILE}"
}

compose_for() {
  local volume="$1"
  shift

  sudo -u deploy env -i \
    HOME="${DEPLOY_HOME}" \
    PATH="${PATH}" \
    DEPLOY_ENV='staging' \
    APP_ENVIRONMENT='Staging' \
    DB_VOLUME_NAME="${volume}" \
    IMAGE_TAG="${current_sha}" \
    WEB_ALIAS="${WEB_ALIAS}" \
    docker compose \
      --env-file "${SECRETS_FILE}" \
      --project-name "${COMPOSE_PROJECT}" \
      --file "${current_release}/${COMPOSE_RELATIVE_PATH}" \
      "$@"
}

assert_compose_volume() {
  local volume="$1"

  compose_for "${volume}" config --format json |
    jq --exit-status --arg expected "${volume}" \
      '.volumes.db_data.name == $expected' >/dev/null ||
    fail "Current release does not resolve db_data to approved volume ${volume}."
}

service_container_id() {
  local volume="$1"
  local service="$2"
  compose_for "${volume}" ps --quiet "${service}" 2>/dev/null
}

wait_for_service() {
  local volume="$1"
  local service="$2"
  local attempt container_id running health

  for attempt in $(seq 1 90); do
    container_id="$(service_container_id "${volume}" "${service}")"
    if [[ -n "${container_id}" ]]; then
      running="$(docker inspect --format '{{.State.Running}}' "${container_id}" 2>/dev/null || true)"
      health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "${container_id}" 2>/dev/null || true)"
      if [[ "${running}:${health}" == 'true:healthy' ]]; then
        return 0
      fi
      [[ "${health}" != 'unhealthy' ]] || return 1
    fi
    sleep 2
  done
  return 1
}

backup_database() {
  local volume="$1"
  local label="$2"
  local timestamp final_backup final_checksum backup_hash

  timestamp="$(date -u '+%Y%m%dT%H%M%S%NZ')"
  final_backup="${BACKUP_DIR}/${timestamp}-${label}.dump"
  final_checksum="${final_backup}.sha256"
  [[ ! -e "${final_backup}" && ! -e "${final_checksum}" ]] ||
    fail "Backup destination already exists: ${final_backup}"

  temporary_backup="$(mktemp "${BACKUP_DIR}/.${timestamp}-${label}.XXXXXX.dump")"
  chmod 0600 "${temporary_backup}"
  compose_for "${volume}" exec -T db \
    sh -ceu 'exec pg_dump --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --format=custom --no-owner --no-acl' \
    > "${temporary_backup}"
  [[ -s "${temporary_backup}" ]] || fail 'Database backup is empty.'
  compose_for "${volume}" exec -T db pg_restore --list \
    < "${temporary_backup}" >/dev/null
  mv -- "${temporary_backup}" "${final_backup}"
  temporary_backup=''

  backup_hash="$(sha256sum "${final_backup}" | awk '{ print $1 }')"
  temporary_checksum="$(mktemp "${BACKUP_DIR}/.${timestamp}-${label}.XXXXXX.sha256")"
  chmod 0600 "${temporary_checksum}"
  printf '%s  %s\n' "${backup_hash}" "$(basename "${final_backup}")" > "${temporary_checksum}"
  mv -- "${temporary_checksum}" "${final_checksum}"
  temporary_checksum=''
  log "Validated backup: ${final_backup}"
}

restart_old_environment() {
  local rollback_ok=1
  local candidate_database_id='' old_database_id='' mounted_volume='' selected_after=''

  set +e
  log "Attempting rollback to retained volume ${old_volume}."
  if (( selector_switched == 1 )); then
    compose_for "${candidate_volume}" stop --timeout 30 app >/dev/null 2>&1 || true
    candidate_database_id="$(service_container_id "${candidate_volume}" db)"
    if [[ -n "${candidate_database_id}" && "$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "${candidate_database_id}" 2>/dev/null)" == 'healthy' ]]; then
      ( backup_database "${candidate_volume}" "failed-candidate-${current_sha}" ) || true
    fi
    compose_for "${candidate_volume}" stop --timeout 30 db >/dev/null 2>&1 || true
    write_selector "${old_volume}" || rollback_ok=0
  fi
  compose_for "${old_volume}" up --detach --force-recreate --no-deps db >/dev/null 2>&1 || rollback_ok=0
  wait_for_service "${old_volume}" db || rollback_ok=0
  old_database_id="$(service_container_id "${old_volume}" db)"
  if [[ -n "${old_database_id}" ]]; then
    mounted_volume="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/var/lib/postgresql/data"}}{{.Name}}{{end}}{{end}}' "${old_database_id}" 2>/dev/null)"
    [[ "${mounted_volume}" == "${old_volume}" ]] || rollback_ok=0
  else
    rollback_ok=0
  fi
  IFS= read -r selected_after < "${SELECTOR_FILE}" || rollback_ok=0
  [[ "${selected_after}" == "${old_volume}" ]] || rollback_ok=0
  compose_for "${old_volume}" up --detach --force-recreate --no-deps app >/dev/null 2>&1 || rollback_ok=0
  wait_for_service "${old_volume}" app || rollback_ok=0
  if (( rollback_ok == 1 )); then
    log 'Rollback restored the original staging database and application.'
  else
    log 'Rollback did not fully restore the original selector, volume, and application; manual intervention is required.'
  fi
  set -e
}

cleanup() {
  if [[ -n "${temporary_backup}" && -f "${temporary_backup}" ]]; then
    rm -f -- "${temporary_backup}"
  fi
  if [[ -n "${temporary_checksum}" && -f "${temporary_checksum}" ]]; then
    rm -f -- "${temporary_checksum}"
  fi
}

on_exit() {
  local status=$?
  trap - EXIT
  if (( status != 0 && cutover_started == 1 && cutover_complete == 0 )); then
    restart_old_environment
  fi
  cleanup
  exit "${status}"
}
trap on_exit EXIT

[[ $# -eq 3 ]] || fail 'Usage: switch-portfolio-staging-database <candidate-volume> <expected-current-sha> <expected-source-sha256>'
readonly candidate_volume="$1"
readonly expected_sha="$2"
readonly expected_source_sha256="$3"

[[ "$(id -u)" -eq 0 ]] || fail 'The staging database switch must run as root.'
[[ "$(readlink -f -- "$0")" == "${INSTALLED_SCRIPT}" ]] ||
  fail "Run the fixed host copy at ${INSTALLED_SCRIPT}."
[[ "$(stat -c '%U:%G' -- "${INSTALLED_SCRIPT}")" == 'root:root' ]] ||
  fail "${INSTALLED_SCRIPT} must be owned by root:root."
(( (8#$(stat -c '%a' -- "${INSTALLED_SCRIPT}") & 0022) == 0 )) ||
  fail "${INSTALLED_SCRIPT} must not be writable by group or other users."
[[ "${candidate_volume}" =~ ^portfolio-staging-postgres-restored-[a-z0-9]+$ ]] ||
  fail 'Candidate volume name is outside the staging restore allowlist.'
[[ "${expected_sha}" =~ ^[0-9a-f]{40}$ ]] || fail 'Expected SHA must be 40 lowercase hexadecimal characters.'
[[ "${expected_source_sha256}" =~ ^[a-f0-9]{64}$ ]] || fail 'Expected source SHA-256 must be 64 lowercase hexadecimal characters.'

for command in awk basename curl docker flock jq mktemp readlink seq sha256sum stat sudo; do
  command -v "${command}" >/dev/null 2>&1 || fail "Required command is unavailable: ${command}"
done

assert_protected_file "${SECRETS_FILE}"
[[ -d "${BACKUP_DIR}" && ! -L "${BACKUP_DIR}" ]] || fail "Missing backup directory: ${BACKUP_DIR}"
docker volume inspect "${candidate_volume}" >/dev/null 2>&1 || fail 'Candidate volume does not exist.'
[[ "$(docker volume inspect --format '{{index .Labels "com.ghobrial.portfolio.purpose"}}' "${candidate_volume}")" == 'staging-restored-candidate' ]] ||
  fail 'Candidate volume is missing its staging restore label.'
[[ "$(docker volume inspect --format '{{index .Labels "com.ghobrial.portfolio.source-sha256"}}' "${candidate_volume}")" == "${expected_source_sha256}" ]] ||
  fail 'Candidate volume source checksum does not match the approved archive.'
[[ "$(docker volume inspect --format '{{index .Labels "com.docker.compose.project"}}' "${candidate_volume}")" == "${COMPOSE_PROJECT}" ]] ||
  fail 'Candidate volume has the wrong Compose project label.'
[[ "$(docker volume inspect --format '{{index .Labels "com.docker.compose.volume"}}' "${candidate_volume}")" == 'db_data' ]] ||
  fail 'Candidate volume has the wrong Compose volume label.'
[[ -z "$(docker ps --quiet --filter "volume=${candidate_volume}")" ]] ||
  fail 'A running test container is still attached to the candidate volume.'

exec 9>"${LOCK_FILE}"
flock --timeout 60 9 || fail 'Another portfolio operation currently holds the deployment lock.'

[[ -L "${CURRENT_LINK}" ]] || fail 'Current staging release link is missing.'
current_release="$(readlink -f -- "${CURRENT_LINK}")"
[[ "${current_release}" == "${RELEASES_DIR}/"* ]] || fail 'Current release points outside the release directory.'
[[ -f "${current_release}/.source-sha" && ! -L "${current_release}/.source-sha" ]] || fail 'Current release source marker is missing.'
IFS= read -r current_sha < "${current_release}/.source-sha"
[[ "${current_sha}" == "${expected_sha}" ]] || fail 'Current staging SHA does not match the requested cutover SHA.'

old_volume="$(read_selector)"
[[ "${old_volume}" != "${candidate_volume}" ]] || fail 'Candidate volume is already selected.'
assert_compose_volume "${old_volume}"
assert_compose_volume "${candidate_volume}"
wait_for_service "${old_volume}" db || fail 'Current staging database is not healthy.'
wait_for_service "${old_volume}" app || fail 'Current staging application is not healthy.'
old_database_id="$(service_container_id "${old_volume}" db)"
old_mounted_volume="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/var/lib/postgresql/data"}}{{.Name}}{{end}}{{end}}' "${old_database_id}")"
[[ "${old_mounted_volume}" == "${old_volume}" ]] ||
  fail 'Running staging database mount does not match the protected selector.'

cutover_started=1
log 'Stopping the staging application to quiesce database writes.'
compose_for "${old_volume}" stop --timeout 30 app >/dev/null

nonseed_rows="$(compose_for "${old_volume}" exec -T db sh -ceu 'exec psql --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --tuples-only --no-align --command="$1"' sh '
SELECT
  (SELECT count(*) FROM "AspNetRoleClaims") +
  (SELECT count(*) FROM "AspNetRoles") +
  (SELECT count(*) FROM "AspNetUserClaims") +
  (SELECT count(*) FROM "AspNetUserLogins") +
  (SELECT count(*) FROM "AspNetUserRoles") +
  (SELECT count(*) FROM "AspNetUserTokens") +
  (SELECT count(*) FROM "AspNetUsers") +
  (SELECT count(*) FROM "BowlingFrames") +
  (SELECT count(*) FROM "BowlingGames") +
  (SELECT count(*) FROM "BowlingSessions") +
  (SELECT count(*) FROM "ArchivedStarTimes") +
  (SELECT count(*) FROM "StarTimes") +
  (SELECT count(*) FROM "DogTimes") +
  (SELECT count(*) FROM "CardCollections") +
  (SELECT count(*) FROM "CardIds") +
  (SELECT count(*) FROM "GameNightGameNightGame") +
  (SELECT count(*) FROM "GameNightMeals") +
  (SELECT count(*) FROM "GameNightUserStatuses") +
  (SELECT count(*) FROM "GameNights") +
  (SELECT count(*) FROM "Games") +
  (SELECT count(*) FROM legacy."GameNightUserOrders") +
  (SELECT count(*) FROM legacy."__EFMigrationsHistory");')"
[[ "${nonseed_rows}" == '0' ]] ||
  fail "Current staging gained ${nonseed_rows} non-seed rows; refusing to replace them automatically."

backup_database "${old_volume}" "pre-mysql-cutover-${current_sha}"
log 'Stopping the original staging database.'
selector_switched=1
compose_for "${old_volume}" stop --timeout 30 db >/dev/null

write_selector "${candidate_volume}"
log "Starting PostgreSQL from candidate volume ${candidate_volume}."
compose_for "${candidate_volume}" up --detach --force-recreate --no-deps db >/dev/null
wait_for_service "${candidate_volume}" db || fail 'Candidate database did not become healthy.'

compose_for "${candidate_volume}" run --rm --no-deps migrate >/dev/null
compose_for "${candidate_volume}" up --detach --force-recreate --no-deps app >/dev/null
wait_for_service "${candidate_volume}" app || fail 'Application did not become healthy on the candidate database.'

database_id="$(service_container_id "${candidate_volume}" db)"
mounted_volume="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/var/lib/postgresql/data"}}{{.Name}}{{end}}{{end}}' "${database_id}")"
[[ "${mounted_volume}" == "${candidate_volume}" ]] || fail 'Running database is not mounted from the selected candidate volume.'

app_id="$(service_container_id "${candidate_volume}" app)"
docker exec "${app_id}" curl --connect-timeout 5 --max-time 15 --fail --silent --show-error \
  http://127.0.0.1:8080/healthz >/dev/null
curl --connect-timeout 5 --max-time 20 --fail --silent --show-error \
  https://staging.ghobrial.dev/healthz >/dev/null

cutover_complete=1
log "Staging database switch completed at ${current_sha}; original volume ${old_volume} was retained."
